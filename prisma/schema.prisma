generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Layer 1: Identity. A person who owns Assentry identity and authorises agents.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  // Fields an agent may be consented to disclose to a verified partner,
  // filtered per-grant by Grant.consentedFields.
  profile      Json     @default("{}")

  agents    Agent[]
  grants    Grant[]
  auditLogs AuditLog[]
}

// Layer 2: Agent. A connected AI orchestrator instance (Claude/GPT/Grok/etc),
// treated as an untrusted bearer — never holds persistent identity itself.
model Agent {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  platform  String // "claude" | "chatgpt" | "grok" | "other"
  label     String? // user-facing name, e.g. "My Claude assistant"
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  // Lets this specific agent connection prove itself when it talks to Assentry
  // on its own, separate from the user's own login session. Set via the
  // OAuth token exchange (routes/oauthToken.ts) after consent — never
  // generated for or shown to a human. Null between consent and token
  // exchange (the brief window while the AI client completes the OAuth
  // dance).
  secretHash String? @unique

  grants    Grant[]
  auditLogs AuditLog[]
}

// The authorisation a user grants to an agent: which data may be disclosed,
// plus expiry + revocation. This is the object a signed credential is
// issued against. No separate "scope"/action concept for now — a valid
// grant means "this agent may act for this person," full stop; per-action
// restriction was real friction for too little benefit at this stage and
// can come back later as a deliberate design, not reinstated piecemeal.
model Grant {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  agentId         String
  agent           Agent     @relation(fields: [agentId], references: [id])
  consentedFields String[] @default([]) // profile fields this grant may disclose, e.g. ["name","email","resume"]
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  auditLogs AuditLog[]
  signInRequests SignInRequest[]

  @@index([userId])
  @@index([agentId])
}

// An AI client (e.g. Claude) that has dynamically registered itself as an
// OAuth client, so it can walk a person through the "Connect" flow without
// Assentry pre-issuing it anything by hand. Public client only — no secret,
// PKCE is mandatory instead.
model OAuthClient {
  id           String   @id @default(uuid())
  clientId     String   @unique
  clientName   String?
  redirectUris String[]
  createdAt    DateTime @default(now())

  authorizationCodes OAuthAuthorizationCode[]
}

// A short-lived, single-use code from the consent screen, exchanged for an
// access token at the token endpoint. This is where the Agent row actually
// gets created — the OAuth consent *is* "connecting an agent".
model OAuthAuthorizationCode {
  id                  String      @id @default(uuid())
  code                String      @unique
  clientId            String
  client              OAuthClient @relation(fields: [clientId], references: [id])
  userId              String
  agentId             String
  redirectUri         String
  codeChallenge       String
  codeChallengeMethod String
  // The person chose to replace this earlier connection: when the code is
  // exchanged, its active grants move to the new agent and it's disconnected.
  replacesAgentId     String?
  expiresAt           DateTime
  usedAt              DateTime?
  createdAt           DateTime    @default(now())
}

// Layer 3: Business. A participating site/service that verifies grants.
// A developer integrating Assentry into their own site. Deliberately a separate
// account from User (an end user's identity) — the two are different
// audiences with different trust boundaries, and their session tokens are
// not interchangeable (see lib/developerAuth.ts).
model Developer {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  partners Partner[]
}

model Partner {
  id           String   @id @default(uuid())
  name         String
  apiKeyHash   String   @unique
  createdAt    DateTime @default(now())

  // Owning developer. Nullable: partners created before developer accounts
  // existed (e.g. the demo site) have no owner and can't be managed
  // from the console.
  developerId String?
  developer   Developer? @relation(fields: [developerId], references: [id])
  // Non-secret prefix of the current key, so a developer can tell keys
  // apart in the console. The full key is never stored.
  apiKeyPreview String?
  // A revoked partner's key is rejected everywhere (requirePartner).
  revokedAt DateTime?

  // The site's hostname, e.g. "shop.example.com". Shown to agents so they
  // can check it against the page they're on, so it only counts once
  // verified: Assentry fetched /.well-known/assentry-domain-verification
  // from that host and found this partner's token (served by the SDK).
  // Browser-agent sign-in is refused until then.
  domain                  String?
  domainVerificationToken String?
  domainVerifiedAt        DateTime?

  // The profile details this site says it needs. /profile releases only
  // fields that are both declared here and allowed by the person's grant.
  declaredFields String[] @default([])

  // Safe to put in a browser-facing URL (unlike id/apiKeyHash semantics —
  // id already is, but this makes the "safe to expose" contract explicit
  // for the account-linking flow below).
  publicId      String   @unique @default(uuid())
  // Where this partner is allowed to be redirected back to after an
  // account-link confirmation — validated the same way OAuthClient
  // redirect_uris are, to prevent an attacker redirecting a link code
  // somewhere unregistered.
  linkRedirectUris String[] @default([])

  auditLogs AuditLog[]
  accountLinkCodes AccountLinkCode[]
  signInRequests SignInRequest[]
}

// Case 2 from STRATEGY.md's "what 'the agent logs in' actually means":
// a one-time, human-driven confirmation that an Assentry user is the same
// person as an existing account on a participating site. The partner
// exchanges this with its own API key (a confidential client), unlike the
// agent connector's public-client PKCE flow — the partner already has a
// secret for server-to-server use.
model AccountLinkCode {
  id          String    @id @default(uuid())
  code        String    @unique
  partnerId   String
  partner     Partner   @relation(fields: [partnerId], references: [id])
  userId      String
  redirectUri String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
}

// Every verification/profile-access decision, independent of what the agent claims.
model AuditLog {
  id        String   @id @default(uuid())
  // Nullable: a malformed or forged credential may not resolve to any real
  // user/agent at all, and that denial still needs to be logged.
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  agentId   String?
  agent     Agent?   @relation(fields: [agentId], references: [id])
  grantId   String?
  grant     Grant?   @relation(fields: [grantId], references: [id])
  partnerId String?
  partner   Partner? @relation(fields: [partnerId], references: [id])

  action    String // e.g. "verify" | "profile_access" | "grant_created" | "grant_revoked"
  result    String // "allowed" | "denied"
  reason    String? // e.g. "expired" | "revoked" | "scope_mismatch" | "ok"
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([agentId])
}

// A browser agent signing in to a participating site without ever handing the
// site its credential. The site (with its API key) asks for a request and
// shows the short code; the agent approves that code through its own
// Assentry connection (MCP approve_sign_in), which is what ties the request
// to a person's grant; the site then collects it, once, server-to-server.
model SignInRequest {
  id          String    @id @default(uuid())
  // SHA-256 of the code; the code itself is only ever returned to the site
  // once, when it's issued, so a database leak exposes no live codes.
  codeHash    String    @unique
  partnerId   String
  partner     Partner   @relation(fields: [partnerId], references: [id])
  grantId     String?
  grant       Grant?    @relation(fields: [grantId], references: [id])
  approvedAt  DateTime?
  collectedAt DateTime?
  // Set when the person ends this sign-in from the Sign-ins screen; the
  // credential issued for it carries this request's id and stops working.
  endedAt     DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([grantId])
}

// Key pairs that sign agent credentials (ES256). Public halves are published
// at /.well-known/jwks.json; private halves are stored encrypted with a key
// derived from JWT_SECRET. Kept after retirement so credentials signed
// earlier can still be checked until they expire.
model SigningKey {
  id                  String    @id // the JWT "kid"
  algorithm           String
  publicJwk           Json
  privateKeyEncrypted String
  createdAt           DateTime  @default(now())
  retiredAt           DateTime?
}
